{
  "name": "presentkim/libcontainer",
  "description": "Virtual inventory menus (entity containers) for axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\libcontainer\\": "src/kim/present/libcontainer/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\libcontainer\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
